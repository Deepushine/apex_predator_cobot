{
  "system": {
    "name": "APEX_PREDATOR",
    "version": "2.0.0",
    "description": "Master/Slave Handshake Protocol - Industrial Robotics Control"
  },
  
  "hardware": {
    "arduino": {
      "board": "Arduino Mega 2560",
      "serial_port": "COM3",
      "baud_rate": 115200,
      "handshake_timeout": 5.0
    },
    "motors": {
      "type": "NEMA 17 RMCS-1010",
      "torque_rating_kg_cm": 5.6,
      "steps_per_rev": 200,
      "microsteps": 8,
      "max_rpm": 100,
      "notes": "DRV8825 drivers set to 1/8 microstepping. Vref tuned to 0.73V (1.46A max current)"
    },
    "drivers": {
      "model": "DRV8825",
      "microstep_mode": 8,
      "vref_voltage": 0.73,
      "max_current": 1.46,
      "notes": "One driver per motor (Base, Shoulder, Elbow)"
    },
    "gear_ratios": {
      "base": 1.0,
      "shoulder": 20.0,
      "elbow": 20.0,
      "notes": "Gear reduction increases torque and precision. Shoulder/Elbow for heavy lifting."
    },
    "limit_switches": {
      "enabled": true,
      "type": "KW12 Mechanical",
      "logic": "Normally Open (NO), Two-Wire",
      "pins": {
        "x_min": 3,
        "y_min": 14,
        "z_min": 18
      },
      "debounce_ms": 20,
      "homing_approach_speed": 10,
      "homing_backoff_degrees": 5,
      "notes": "Double-tap homing protocol: initial fast hit, then back off and slow approach"
    }
  },

  "kinematic_limits": {
    "notes": "Kinematic Shield - prevents hardware damage and collision",
    "joint_x_base": {
      "name": "Base Rotation",
      "min_angle": -180,
      "max_angle": 180,
      "unit": "degrees",
      "speed_limit": 90,
      "acceleration_limit": 45
    },
    "joint_y_shoulder": {
      "name": "Shoulder Lift",
      "min_angle": -30,
      "max_angle": 90,
      "unit": "degrees",
      "speed_limit": 60,
      "acceleration_limit": 30,
      "notes": "Constrained to prevent tipping. -30° to 90° safe range."
    },
    "joint_z_elbow": {
      "name": "Elbow Extension",
      "min_angle": -90,
      "max_angle": 90,
      "unit": "degrees",
      "speed_limit": 45,
      "acceleration_limit": 22,
      "notes": "Full range for articulation, constrained by shoulder limits."
    }
  },

  "communication": {
    "protocol": "Master/Slave Handshake",
    "command_format": "<MOVE X{angle} Y{angle} Z{angle}>",
    "home_command": "HOME",
    "command_terminator": "\n",
    "response_ok": "OK",
    "response_error": "ERR",
    "heartbeat_disabled": "Zero-fail handshake eliminates need for heartbeat",
    "examples": {
      "move_command": "<MOVE X45.0 Y90.0 Z-30.0>",
      "home_all_joints": "HOME",
      "python_blocks_for_response": "Python waits in blocking loop for 'OK'"
    }
  },

  "camera": {
    "index": 0,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "auto_exposure": true
  },

  "safety": {
    "min_hand_distance": 200,
    "safe_zone_radius": 150,
    "max_velocity": 100,
    "emergency_stop_enabled": true,
    "proximity_alert_enabled": true,
    "temperature_limit": 400,
    "handshake_timeout": 5.0
  },

  "end_effectors": {
    "soldering_iron": {
      "preheat_time": 30,
      "target_temperature": 350,
      "follow_distance": 50,
      "pwm_pin": 9,
      "enable_pin": 8
    },
    "gripper": {
      "servo_pin": 11,
      "open_angle": 90,
      "close_angle": 0,
      "force_limit": 5
    }
  },

  "vision": {
    "hand_tracking": {
      "enabled": true,
      "max_hands": 2,
      "detection_confidence": 0.7,
      "tracking_confidence": 0.5
    },
    "object_detection": {
      "enabled": true,
      "model": "custom",
      "confidence_threshold": 0.7,
      "detection_cooldown": 1.0
    }
  },

  "logging": {
    "level": "INFO",
    "console_output": true,
    "file_output": true,
    "log_file": "apex_predator.log",
    "max_file_size": 10485760,
    "backup_count": 5
  },

  "gui": {
    "theme": "dark",
    "video_fps": 30,
    "status_update_rate": 10,
    "window_width": 1600,
    "window_height": 900
  }
}
