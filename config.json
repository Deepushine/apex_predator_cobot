{
  "system": {
    "name": "APEX_PREDATOR",
    "version": "2.1.0",
    "description": "Master/Slave Handshake Protocol - Industrial Robotics Control"
  },

  "hardware": {
    "arduino": {
      "board": "Arduino Mega 2560",
      "serial_port": "COM12",
      "baud_rate": 115200,
      "handshake_timeout": 5.0,
      "home_timeout": 60.0
    },
    "shield": "RAMPS 1.6",
    "motors": {
      "type": "NEMA 17 RMCS-1010",
      "torque_rating_kg_cm": 5.6,
      "steps_per_rev": 200,
      "microsteps": 8,
      "notes": "DRV8825 @ 1/8 microstep. Vref=0.73V (1.46A max). 3 motors on X/Y/Z."
    },
    "drivers": {
      "model": "DRV8825",
      "microstep_mode": 8,
      "vref_voltage": 0.73,
      "max_current": 1.46
    },
    "gear_ratios": {
      "base_x": 1.0,
      "shoulder_y": 20.0,
      "elbow_z": 20.0
    },
    "limit_switches": {
      "type": "MS-114 SPDT (NO wiring)",
      "logic": "Normally Open, INPUT_PULLUP — resting=HIGH, pressed=LOW",
      "wiring": "COM to GND, NO to signal pin",
      "pins": { "x_min": 3, "y_min": 14, "z_min": 18 },
      "debounce_ms": 20,
      "homing_backoff_degrees": 5
    },
    "atc_servos": {
      "note": "2x MG90S diagonal opposite — top-left (pin 4) + bottom-right (pin 11)",
      "srv1_top_left_pin": 4,
      "srv2_bot_right_pin": 11,
      "unlocked_deg": 0,
      "locked_deg": 65,
      "sweep_delay_ms": 4,
      "freed_pins": [5, 6]
    },
    "esp32_cam": {
      "stream_url": "http://192.168.1.47/stream",
      "note": "Update IP after ESP32-CAM connects to your WiFi network",
      "width": 640,
      "height": 480,
      "fps": 20,
      "buffer_size": 1
    },
    "power": {
      "motor_supply": "12V 10A SMPS",
      "servo_supply": "LM2596 buck from 12V to 5V (3A capacity)",
      "esp32_cam_supply": "18650 + TP4056 Type-C + MT3608 boost to 5V"
    }
  },

  "kinematic_limits": {
    "joint_x_base":     { "min_angle": -180, "max_angle": 180 },
    "joint_y_shoulder": { "min_angle": -30,  "max_angle": 90  },
    "joint_z_elbow":    { "min_angle": -90,  "max_angle": 90  }
  },

  "communication": {
    "protocol": "Master/Slave Handshake",
    "move_format": "<MOVE X{angle} Y{angle} Z{angle}>",
    "commands": {
      "home":    "HOME",
      "lock":    "LOCK",
      "unlock":  "UNLOCK",
      "enable":  "EN",
      "disable": "DIS",
      "tool_id": "TOOL_ID"
    },
    "response_ok":  "OK",
    "response_err": "ERR",
    "handshake_timeout": 5.0,
    "home_timeout": 60.0
  },

  "camera": {
    "source": "esp32_cam",
    "esp32_stream_url": "http://192.168.1.47/stream",
    "fallback_usb_index": 0,
    "width": 640,
    "height": 480,
    "fps": 20,
    "buffer_size": 1
  },

  "safety": {
    "min_hand_distance": 200,
    "safe_zone_radius": 150,
    "max_velocity": 100,
    "emergency_stop_enabled": true,
    "handshake_timeout": 5.0,
    "homing_timeout": 60.0
  },

  "end_effectors": {
    "note": "Tool ID via resistor ladder on ATC cube terminal (A0 pin, 10k pullup)",
    "gripper": {
      "tool_id_resistor_ohms": 1000,
      "tool_id_adc_min": 70, "tool_id_adc_max": 120
    },
    "suction": {
      "tool_id_resistor_ohms": 2200,
      "tool_id_adc_min": 150, "tool_id_adc_max": 220
    },
    "solder": {
      "tool_id_resistor_ohms": 4700,
      "tool_id_adc_min": 290, "tool_id_adc_max": 370
    },
    "none": { "tool_id_adc_min": 900, "tool_id_adc_max": 1023 }
  },

  "logging": {
    "level": "INFO",
    "console_output": true,
    "file_output": true,
    "log_file": "apex_predator.log"
  },

  "gui": {
    "theme": "dark",
    "video_fps": 20,
    "status_update_rate": 10,
    "window_width": 1600,
    "window_height": 900
  }
}
